{
  "name": "@ticatec/script-loader",
  "version": "1.0.0",
  "description": "A powerful TypeScript dynamic script loading and management library with real-time script updates, caching management, and timestamp persistence.",
  "type": "module",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/cjs/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "copy:pkg": "node -e \"const fs=require('fs');fs.writeFileSync('lib/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}');fs.writeFileSync('lib/esm/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "build": "pnpm clean && pnpm build:cjs && pnpm build:esm && pnpm copy:pkg",
    "prebuild": "pnpm lint",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "publish-public": "pnpm publish --access public --no-git-checks",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit && tsc -p tsconfig.esm.json --noEmit"
  },
  "keywords": [
    "script-loader",
    "dynamic-loading",
    "typescript",
    "pino",
    "script-management",
    "real-time-updates",
    "caching",
    "timestamp-persistence",
    "nodejs",
    "javascript",
    "plugin-system",
    "hot-reload",
    "script-engine"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ticatec/scripts-loader.git"
  },
  "author": {
    "name": "Henry Feng",
    "email": "huili.f@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ticatec/scripts-loader/issues"
  },
  "homepage": "https://github.com/ticatec/scripts-loader#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@ticatec/logger-wrapper": "^0.1.0"
  },
  "devDependencies": {
    "@ticatec/logger-wrapper": "^0.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.8.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "pino": "^9.5.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  }
}
